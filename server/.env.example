# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional — GitHub repo analysis ──────────────────────────────────────────
# Strongly recommended: unauthenticated requests are limited to 60/hr per IP.
# A large repo analysis can consume 300+ API calls. With a token: 5000/hr.
GITHUB_TOKEN=your_github_token_here

# ── Optional — Server config ──────────────────────────────────────────────────
PORT=3001

# ── Optional — CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to localhost:5173 in dev.
# Example for production:
# CORS_ORIGINS=https://codeviz.example.com,https://www.codeviz.example.com
CORS_ORIGINS=

# ── Optional — Rate Limiting ──────────────────────────────────────────────────
# Applied to /api/analyze and /api/analyze-repo to prevent abuse.
# Window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP (default: 20)
RATE_LIMIT_MAX=20

# ── Optional — Gemini model override ─────────────────────────────────────────
# Primary model (default: gemini-3.6-flash — GA as of mid-2026, cheaper and more
# token-efficient than 3.5-flash).
# NOTE: gemini-2.0-flash was shut down on June 1, 2026 — do NOT use it.
GEMINI_MODEL=gemini-3.6-flash

# Fallback model used automatically if the primary call fails (e.g. quota/outage).
# Default: gemini-3.5-flash (still valid; was the previously deployed model).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash