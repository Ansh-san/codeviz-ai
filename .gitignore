# ══════════════════════════════════════════════════════
# CodeViz AI — Root .gitignore
# ══════════════════════════════════════════════════════

# ── Dependencies ────────────────────────────────────────
node_modules/
**/node_modules/

# ── Environment files (NEVER commit secrets) ────────────
.env
.env.local
.env.*.local
server/.env
client/.env

# ── Build & dist outputs ────────────────────────────────
dist/
build/
**/dist/
**/build/
client/dist/
server/dist/

# ── Vite cache ──────────────────────────────────────────
client/.vite/
**/.vite/

# ── Logs ────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / Editor artifacts ────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── IDE configs ──────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Package manager lockfiles (keep package-lock.json) ──
yarn.lock
pnpm-lock.yaml
.pnp.js
.pnp/

# ── Test coverage ────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ─────────────────────────────────────────────────
*.tgz
*.tar.gz
.cache/
